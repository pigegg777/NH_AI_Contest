# Client-safe (Vite inlines these into the browser bundle — never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=

# `npm run dev` (plain Vite) does NOT serve /api/storefront-ai/* — those routes are
# Cloudflare Pages Functions (functions/api/storefront-ai/*.js) and only respond when
# requests go through Wrangler. Either:
#   1) set this to "true" to skip the network call and use the heuristic intent
#      builder directly (no Functions backend required), or
#   2) run `npm run dev` + `npm run dev:functions` together and open
#      http://localhost:8788 (not 5173) so requests get proxied to the real Functions.
VITE_STOREFRONT_AI_LOCAL_HEURISTIC=

# Server-only — set these in the Cloudflare Pages project's environment variables
# (Preview and Production), never in this file, never with a VITE_ prefix:
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4.1-mini
