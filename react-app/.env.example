# Client-safe (Vite inlines these into the browser bundle; never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=

# `npm run dev` (plain Vite) does not serve /api/storefront-ai/*.
# Those routes are Cloudflare Pages Functions and only respond when requests go
# through Wrangler.
# Run `npm run dev` + `npm run dev:functions` together and open
# http://localhost:8788 (not 5173) so requests get proxied to the real
# Functions.

# Server-only: set these in the Cloudflare Pages project's environment
# variables (Preview and Production), never in this file, never with a VITE_
# prefix:
#   OPENAI_API_KEY=
#
# Model per AI route. Each route picks the model that suits its job, so each
# has its own key. Leave a key unset to keep the default shown below.
#   OPENAI_MODEL_BULK_NOTE=gpt-5.6-luna              # 일괄 비고/단가/숨김 편집
#   OPENAI_MODEL_SIMILARITY_EXTRACTION=gpt-5.6-luna  # 유사상품 추출
#   OPENAI_MODEL_IMAGE_MATCH=gpt-5.6-terra           # 이미지 적용 대상 매칭
#   OPENAI_MODEL_CARD_STYLE=gpt-5.6-terra            # 카드 디자인 생성
#   OPENAI_MODEL_PAGE_STYLE=gpt-5.6-terra            # 페이지 디자인 생성
#   OPENAI_MODEL_MARKET_RESEARCH=gpt-5.6-sol         # 시장조사 (web_search)
#
# OPENAI_MODEL moves every text route at once, and any route key above wins
# over it. Image generation ignores it — a text model id sent to the images
# endpoint fails — so it has only its own key:
#   OPENAI_MODEL=
#   OPENAI_MODEL_IMAGE_GENERATE=gpt-image-2          # 상품 이미지 생성
