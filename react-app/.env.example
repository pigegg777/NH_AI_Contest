# Client-safe (Vite inlines these into the browser bundle; never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=

# `npm run dev` (plain Vite) does not serve /api/storefront-ai/*.
# Those routes are Cloudflare Pages Functions and only respond when requests go
# through Wrangler.
# Page-style AI now always uses the Functions backend.
# The heuristic toggle below only applies to the card-design AI local fallback.
# Run `npm run dev` + `npm run dev:functions` together and open
# http://localhost:8788 (not 5173) so page-style requests get proxied to the
# real Functions.
VITE_STOREFRONT_AI_LOCAL_HEURISTIC=

# Server-only: set these in the Cloudflare Pages project's environment
# variables (Preview and Production), never in this file, never with a VITE_
# prefix:
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4.1-mini
